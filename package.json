{
  "name": "albaran",
  "productName": "Albaranes",
  "version": "0.2.0",
  "description": "Biblioteca de albaranes escaneados: separa, lee y archiva por meses",
  "main": "src/main.js",
  "author": "cliserca",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "test": "node --test"
  },
  "build": {
    "appId": "com.cliserca.albaran",
    "productName": "Albaranes",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Albaranes"
    },
    "asar": false
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "sql.js": "^1.13.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
